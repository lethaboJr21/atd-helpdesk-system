# Copy this to .env and fill in your values
# NEVER commit .env to git

NODE_ENV=production
PORT=3001

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atd_helpdesk
DB_USER=atd_user
DB_PASSWORD=your_strong_password_here

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=8h

# CORS — set to your domain
CORS_ORIGIN=https://portal.atdalliance.co.za


# Microsoft Entra / Microsoft 365 SSO
MICROSOFT_CLIENT_ID=your_application_client_id
MICROSOFT_TENANT_ID=your_directory_tenant_id
MICROSOFT_CLIENT_SECRET=your_client_secret
MICROSOFT_REDIRECT_URI=https://portal.atdalliance.co.za/helpdesk/api/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAIN=atdalliance.co.za

# Public frontend URL used in emails and SSO redirects
PUBLIC_PORTAL_URL=https://portal.atdalliance.co.za/helpdesk

# Email
EMAIL_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=helpdesk@atdalliance.co.za
EMAIL_PASS=your_mailbox_or_app_password
SMTP_FROM="ATD Helpdesk" <helpdesk@atdalliance.co.za>
ADMIN_EMAIL=jeffreym@atdalliance.co.za